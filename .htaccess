# =========================================================================
# Concept One Developers — Apache configuration
# =========================================================================

DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

# --- Compression ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Browser caching -----------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Assets are cache-busted with ?v=<mtime>, so they can be cached hard.
  <FilesMatch "\.(css|js|svg|jpg|jpeg|png|webp|avif|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Security headers --------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# --- Keep-alive ----------------------------------------------------------
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>

# --- Clean URLs ----------------------------------------------------------
# /about  ->  /about.php   (both keep working)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS — uncomment once your SSL certificate is live.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Clean URLs: every internal link is extensionless (/about, /project?p=…).
  # Old or typed .php addresses 301 to the clean form so only one URL is ever
  # indexed. POSTs are never redirected — a redirect would drop the form data.
  RewriteCond %{REQUEST_METHOD} !^POST$
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  RewriteCond %{REQUEST_METHOD} !^POST$
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /about serves about.php internally.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  # Only rewrite when the .php target really exists. Without this, a missing
  # path rewrites to nope.php.php and .htaccess re-runs the ruleset, looping
  # until Apache's internal redirect limit returns a 500 instead of the 404 page.
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# --- Hardening -----------------------------------------------------------
Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(log|md|json|lock)$">
  Require all denied
</FilesMatch>

# Local-preview router for PHP's built-in server; never served in production.
<Files "dev-router.php">
  Require all denied
</Files>
